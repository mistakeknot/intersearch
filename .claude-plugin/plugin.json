{
  "name": "intersearch",
  "version": "0.2.3",
  "description": "Shared embedding and search infrastructure for the Interverse ecosystem \u2014 sentence-transformer embeddings, persistent vector store, and Exa web search.",
  "author": {
    "name": "mistakeknot"
  },
  "license": "MIT",
  "keywords": [
    "embeddings",
    "search",
    "exa",
    "sentence-transformers",
    "semantic-search",
    "vector-store",
    "shared-library",
    "infrastructure"
  ],
  "skills": [
    "./skills/session-search",
    "./skills/session-resume"
  ],
  "mcpServers": {
    "intersearch": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "intersearch-mcp"
      ]
    }
  }
}
